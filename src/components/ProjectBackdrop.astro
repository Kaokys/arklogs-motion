---
const ribs = Array.from({ length: 10 }, (_, index) => 1 - index * 0.078);
---
<svg class="project-backdrop" viewBox="0 0 1440 640" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="project-halftone" width="9" height="9" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.1" fill="#45678b" />
    </pattern>
    <pattern id="project-paper-grain" width="39" height="31" patternUnits="userSpaceOnUse">
      <path d="M3 11h1m9 12h1m4-19h1m9 12h1m5 12h1" stroke="#718c9b" stroke-linecap="round" />
    </pattern>
    <linearGradient id="project-paper-wash">
      <stop stop-color="#a8c3c4" stop-opacity=".48" />
      <stop offset="1" stop-color="#dae7e7" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="project-ribbed-surface" x2="0" y2="1">
      <stop stop-color="#6986a7" />
      <stop offset="1" stop-color="#c4d4de" />
    </linearGradient>
    <path id="project-rib" d="M-126 0C-80-2-77-32-56-42C-35-52-29-48-20-76C-14-96-10-124 0-132C12-126 18-94 24-75C35-44 44-50 63-37C88-20 90-6 126 0" />
    <path id="project-bird" d="M0 13c13 1 22 4 32 9C23 15 21 7 19 0c15 5 26 11 36 23 8-6 12-5 20-2l-9 5c-7 11-16 13-27 12l-9 7 2-12C18 31 7 22 0 13Z" />
    <g id="project-figure">
      <ellipse cx="0" cy="-54" rx="11" ry="3" fill="none" />
      <path d="M-22 0c3-15 3-27 16-32v-4c-6-10 1-17 7-16 9 1 12 9 7 16v4c11 6 13 18 15 32Z" />
    </g>
  </defs>
  <path d="M0 19h285v374H0Z" fill="url(#project-paper-wash)" />
  <path d="M0 0h1440v640H0Z" fill="url(#project-paper-grain)" opacity=".25" />
  <path d="M0 113 205 76 318 152 121 220 0 199Z" fill="#b6cbd9" opacity=".45" />
  <path d="M0 138 185 108 215 135 49 189 0 177Z" fill="url(#project-halftone)" opacity=".5" />
  <path class="paper-shift" d="m0 540 221-110 230 128L302 640H0Z" fill="#d0dfda" opacity=".66" />
  <path class="paper-shift paper-shift-right" d="m1015 142 200-111 225 76v118l-162-63-162 44Z" fill="#d2dfeb" opacity=".77" />
  <path d="m1205 450 235-53v192l-169 31-125-83Z" fill="#b6cbd9" opacity=".45" />
  <path d="m1251 502 189-71v116l-125 30Z" fill="url(#project-halftone)" opacity=".4" />
  <g opacity=".72">
    <path class="overlay-shift" d="M1158 202h282v36h-282Z" fill="#8fa8ba" opacity=".64" />
    <g transform="translate(1321 278)">
      <use href="#project-rib" fill="url(#project-ribbed-surface)" />
      {ribs.map(scale => <use href="#project-rib" transform={`scale(${scale} 1)`} fill="none" stroke="#f4f8f8" stroke-width="1.3" />)}
      <g class="contour-shift" fill="none" stroke="#728d9f" stroke-dasharray="1 2.5">
        {ribs.map(scale => <use href="#project-rib" transform={`scale(${scale} -.86)`} />)}
      </g>
      <path d="M-137 0h264m-127-152v278m-7-270 7-8 7 8m-7 270-7-8m7 8 7-8" fill="none" stroke="#466b9e" />
    </g>
    <path d="M1172 220h268v10h-268Z" fill="#8fa8ba" opacity=".38" />
  </g>
  <g fill="none" stroke="#5f819f" opacity=".64">
    <path class="frame-shift" d="M34 115v36h47v31h72v24h37v26h30v-22h-30m-92-59v-22h58v32h28" />
    <path d="M42 259h61v84H42Z M51 325c4-23 11-36 23-44 13 10 17 20 20 37m-49-19h55m-28-29v68" />
    <path d="M1242 465h56v74h-56Z M1250 527c22-11 38-31 40-55m-49 27h56m-27-34v72" />
    <path d="m1205 508 21-17 13 16-20 17Z" fill="#ad7880" />
    <path d="M1198 482h5v5h-5Zm124 47h5v5h-5ZM36 250h5v5h-5Z" fill="#456d9f" stroke="none" />
  </g>
  <g fill="#4d7390" opacity=".58">
    <g class="bird-hop"><use href="#project-bird" transform="translate(105 162) rotate(-12) scale(.72)" /></g>
    <g class="bird-hop bird-high"><use href="#project-bird" transform="translate(179 122) rotate(7) scale(.48)" /></g>
    <g class="bird-hop bird-low"><use href="#project-bird" transform="translate(58 202) rotate(-18) scale(.37)" /></g>
  </g>
  <path d="M0 395v-30h26v-18h22v15h22v-37h14v37h33v17h30v-17h19v-34h25v52h28v-17h29v32Z" fill="#a5bfc7" opacity=".54" />
  <g fill="#f4f8f7" stroke="#7696a9" opacity=".77">
    <use href="#project-figure" transform="translate(28 423) scale(.72)" />
    <use href="#project-figure" transform="translate(64 410) scale(.91)" />
    <use href="#project-figure" transform="translate(110 426) scale(.63)" />
    <use href="#project-figure" transform="translate(177 414) scale(.78)" />
  </g>
  <g fill="#506b83" opacity=".28" font-family="Georgia, serif">
    <text x="29" y="568" font-size="50">P</text>
    <text x="66" y="597" font-size="24" letter-spacing="4">BENCH</text>
    <text x="1330" y="611" font-size="34">∴</text>
  </g>
  <path d="M-10 235C75 238 87 314 170 306S212 249 272 259M1182 576c114-79 138-26 269-126" fill="none" stroke="#829dae" opacity=".55" />
  <g fill="none" stroke="#6c8cae" opacity=".56" vector-effect="non-scaling-stroke">
    <path d="M33 92v185m-12-170h34m-34 149h34M1387 358v218m-21-196h42m-42 169h42" />
    <path d="M0 386h92l53-54h65m1030-76h65l44 43h91M0 472h70l53 53h102" />
    <circle cx="210" cy="332" r="5" />
    <circle cx="1240" cy="256" r="5" />
    <circle cx="225" cy="525" r="5" />
    <circle cx="1317" cy="157" r="64" />
    <circle cx="1317" cy="157" r="51" stroke-dasharray="3 7" />
    <path d="M1239 157h156m-78-79v158M61 575h270m-234-9v18m201-18v18" />
  </g>
  <path class="ribbon-tilt" d="M-16 492 78 386 122 384 95 463 225 365 247 372 134 475 125 500 75 499 92 452 22 510Z" fill="#f8fbfa" stroke="#a5b9c9" opacity=".83" />
  <path class="ribbon-tilt ribbon-right" d="m1242 408 74-24 99-107 38-1-107 126-66 27-62 76-44 13Z" fill="#f8fbfa" stroke="#a5b9c9" opacity=".83" />
</svg>

<style>
  .project-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .project-backdrop { opacity: .65; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bird-hop, .ribbon-tilt, .paper-shift, .contour-shift {
      transform-box: fill-box;
      transform-origin: center;
    }

    .bird-hop { animation: bird-hop 2.8s steps(1, end) infinite; }
    .bird-high { animation-duration: 3.7s; animation-delay: -1.1s; }
    .bird-low { animation-duration: 4.3s; animation-delay: -2.5s; }
    .paper-shift { animation: paper-shift 7.3s steps(1, end) infinite; }
    .paper-shift-right { animation-duration: 9.1s; animation-delay: -3s; }
    .ribbon-tilt { animation: ribbon-tilt 5.7s steps(1, end) infinite; }
    .ribbon-right { animation-duration: 6.4s; animation-delay: -2s; }
    .overlay-shift { animation: overlay-shift 6.7s steps(1, end) infinite; }
    .frame-shift { animation: frame-shift 4.9s steps(1, end) infinite; }
    .contour-shift {
      transform-origin: center top;
      animation: contour-shift 5.9s steps(1, end) infinite;
    }
  }

  @keyframes bird-hop {
    0%, 100% { transform: none; }
    26% { transform: translate(5px, -7px) rotate(-7deg) scaleY(.85); }
    44% { transform: translate(9px, -12px) rotate(4deg) scaleY(1.08); }
    67% { transform: translate(4px, -5px) rotate(1deg); }
    82% { transform: none; }
  }

  @keyframes paper-shift {
    0%, 100% { transform: none; }
    37% { transform: translate(-5px, 3px) rotate(-1.25deg); }
    71% { transform: translate(3px, -3px) rotate(.8deg); }
  }

  @keyframes ribbon-tilt {
    0%, 100% { transform: none; }
    33% { transform: translate(2px, -4px) rotate(1.8deg); }
    66% { transform: translate(-3px, 2px) rotate(-1.3deg); }
  }

  @keyframes overlay-shift {
    0%, 100% { transform: none; }
    24% { transform: translateY(-5px); }
    55% { transform: translateY(3px); }
    75% { transform: translateY(-2px); }
  }

  @keyframes frame-shift {
    0%, 100% { transform: none; }
    32% { transform: translate(4px, 2px); }
    65% { transform: translate(-3px, 0); }
  }

  @keyframes contour-shift {
    0%, 100% { transform: none; }
    29% { transform: skewX(2deg) scaleY(.94); }
    60% { transform: skewX(-1.5deg) scaleY(1.04); }
  }
</style>
