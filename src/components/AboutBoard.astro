---
import { Image } from 'astro:assets';
import kaoProfile from '../assets/kao-profile.png';

const tracks = [
  { id: '2X485T9Z5Ly0xyaghN73ed', title: 'Let It Happen', position: 't1' },
  { id: '4k3cMasUNMHi8OBYORYtvJ', title: 'Lost in Yesterday', position: 't2' },
];
---

<div id="kao-screen-board">
<header><h1>About Me</h1></header>
<div class="board-stage"><div class="evidence" data-group="profile">
<div class="threads" aria-hidden="true"></div>
<article class="sheet idcard" data-group="profile"><i class="strap" aria-hidden="true"></i><div class="band">ARKLOGS <span>PROFILE ID</span></div><div class="badge-faces"><div class="idface">
  <Image class="badge-portrait" src={kaoProfile} width={160} format="webp" alt="Kao’s profile picture" />
  <div><h2>Kao</h2><p>Cybersecurity student<br>Khon Kaen University, Thailand</p></div>
</div>
<div class="idback" hidden>
  <Image class="intro-portrait" src={kaoProfile} width={160} format="webp" alt="Kao’s profile picture" />
  <div><h2>Hi, I’m Kao.</h2><p>I study cybersecurity at Khon Kaen University in Thailand.</p><p>I like building things for the web, working with ESP32 boards, and keeping notes on what I learn.</p></div>
</div></div><button class="flip" type="button" aria-expanded="false">Flip ID ↻</button></article>
<article class="sheet bio" data-group="profile">
  <h2>Hi, I’m Kao.</h2>
  <p class="bio-greeting">Nice to meet you!</p>
  <p>I’m a cybersecurity student at Khon Kaen University in Thailand. I’m especially interested in red teaming.</p>
  <p>I like CTFs, odd corners of the web, and keeping track of the things I learn along the way. This page is a small collection of those bits and pieces.</p>
</article>
<article class="sheet dev profile-note" data-group="images">
  <small>THE SHORT VERSION</small>
  <h2>A few things about me.</h2>
  <dl>
    <div><dt>Studying at</dt><dd>Khon Kaen University</dd></div>
    <div><dt>Based in</dt><dd>Thailand</dd></div>
    <div><dt>Interested in</dt><dd>Cybersecurity · Red teaming</dd></div>
  </dl>
  <button class="after-hours" type="button" aria-haspopup="dialog">After Hours ↗</button>
</article>
<article class="sheet game g1" data-group="favorites"><small>FAVORITE GAME</small><img class="gameart" src="/arknights-icon.jpg" width="45" height="45" alt=""><h2>Arknights</h2><p>Strategy · Mobile</p></article>
<article class="sheet game g2" data-group="favorites"><small>FAVORITE GAME</small><img class="gameart" src="/oxygen-not-included-icon.jpg" width="45" height="45" alt=""><h2>Oxygen Not Included</h2><p>Colony sim · PC</p></article>
{tracks.map(({ id, title, position }) => (
  <article class:list={['sheet', 'track', position]} data-group="favorites" aria-label={title}>
    <iframe
      src={`https://open.spotify.com/embed/track/${id}?theme=0`}
      title={`${title} — Tame Impala on Spotify`}
      width="100%"
      height="152"
      loading="lazy"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    ></iframe>
  </article>
))}
<article class="sheet github" data-group="profiles"><small>DEVELOPER PROFILE</small><h2><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/github.svg" alt=""> GitHub</h2><p><a href="https://github.com/Kaokys">@Kaokys ↗</a></p></article>
<article class="sheet htb" data-group="profiles"><small>LAB PROFILE</small><h2><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/hackthebox.svg" alt=""> Hack The Box</h2><p>Cybersecurity labs</p></article>
<article class="sheet social" data-group="profiles"><small>SOCIAL</small><div class="socials"><a href="https://github.com/Kaokys"><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/github.svg" alt=""><span>GitHub</span></a><div><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/medium.svg" alt=""><span>Medium</span></div><div><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/instagram.svg" alt=""><span>Instagram</span></div><div><img class="brand-icon" src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/linkedin.svg" alt=""><span>LinkedIn</span></div></div></article>
<figure class="sheet photo snap1" data-group="images"><button type="button" class="enlarge" aria-label="Enlarge Arklogs landscape illustration"><img src="/atlas-landscape.svg" alt="Arklogs landscape illustration"></button><figcaption>Love this slice of the homepage.</figcaption></figure>
<figure class="sheet photo snap2" data-group="images"><button type="button" class="enlarge" aria-label="Enlarge Layered project illustration"><img src="/atlas-prj.svg" alt="Layered project illustration"></button><figcaption>Sketch for the project card.</figcaption></figure>
</div>
</div><nav class="board-tabs" aria-label="Board sections"><button type="button" data-view="profile" aria-pressed="true">Profile</button><button class="cursor-interaction" type="button" data-view="favorites" aria-pressed="false">Favorites</button><button class="cursor-interaction" type="button" data-view="profiles" aria-pressed="false">Social</button><button class="cursor-interaction" type="button" data-view="images" aria-pressed="false">Files</button></nav>
<dialog class="image-dialog" aria-label="Pinned image"><button class="close" type="button">Close ×</button><img alt=""><p></p></dialog>
<dialog class="after-hours-dialog" aria-labelledby="after-hours-title">
  <button class="close" type="button">Close ×</button>
  <small>AFTER HOURS</small>
  <h2 id="after-hours-title">Curious by default.</h2>
  <p>I like spending my free time on CTFs and hands-on labs. I’m especially interested in web security, reverse engineering, and red teaming.</p>
  <p>When I’m away from the keyboard, you’ll usually find me listening to music, playing games, or out on my motorcycle.</p>
</dialog>
</div>

<script>
let teardown: (() => void) | undefined;

function initAboutBoard() {
  const root=document.getElementById('kao-screen-board');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = 'true';
  const grid=root.querySelector<HTMLElement>('.evidence')!;
  const lines=grid.querySelector('.threads');
  const stage=root.querySelector<HTMLElement>('.board-stage')!;
  const tabs=root.querySelector<HTMLElement>('.board-tabs')!;
  for (const button of tabs.querySelectorAll<HTMLButtonElement>('button')) {
    button.addEventListener('click',()=>{
      grid.dataset.group=button.dataset.view ?? 'profile';
      tabs.querySelectorAll('button').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
      draw();
    });
  }
  grid.querySelectorAll('.sheet').forEach(sheet=>{
    const pin=document.createElement('span');
    pin.className='pin'; pin.setAttribute('aria-hidden','true'); sheet.append(pin);
  });
  const pairs=[['idcard','bio'],['idcard','g1'],['g1','g2'],['idcard','t1'],['t1','t2'],['bio','dev'],['dev','github'],['github','htb'],['idcard','snap1'],['t2','snap2'],['snap1','social']];
  const strings=pairs.map(([from,to])=>{
    const line=document.createElement('i'); lines.append(line);
    return {line,start:grid.querySelector('.'+from+' .pin')!,end:grid.querySelector('.'+to+' .pin')!};
  });
  function draw(){
    const wide=getComputedStyle(grid).position==='absolute';
    const main = root.closest('main');
    const header = root.querySelector('header');
    if (main && header) stage.style.setProperty('--board-height', Math.max(0, main.clientHeight - header.offsetHeight - 2) + 'px');
    const scale = wide ? Math.min(stage.clientWidth / grid.offsetWidth, stage.clientHeight / grid.offsetHeight) : 1;
    if(!scale) return;
    grid.style.setProperty('--wide-scale',String(scale));
    const origin=lines.getBoundingClientRect();
    for(const {line,start,end} of strings){
      const a=start.getBoundingClientRect(),b=end.getBoundingClientRect();
      line.hidden = !a.width || !b.width;
      if(line.hidden) continue;
      const dx=b.x+b.width/2-a.x-a.width/2,dy=b.y+b.height/2-a.y-a.height/2;
      Object.assign(line.style,{
        left: ((a.x + a.width / 2 - origin.x) / scale) + 'px',
        top: ((a.y + a.height / 2 - origin.y) / scale - 1) + 'px',
        width: (Math.hypot(dx, dy) / scale) + 'px',
        transform: 'rotate(' + Math.atan2(dy, dx) + 'rad)',
      });
    }
  }
  const observer=new ResizeObserver(draw); observer.observe(stage); observer.observe(grid); grid.querySelectorAll('.sheet').forEach(sheet=>observer.observe(sheet)); draw();
  const flip=root.querySelector<HTMLElement>('.flip')!,front=root.querySelector<HTMLElement>('.idface')!,back=root.querySelector<HTMLElement>('.idback')!;
  const badge = flip.closest<HTMLElement>('.idcard')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let flipping = false;
  let flipAnimation: Animation | undefined;
  flip.addEventListener('click', async () => {
    if (flipping) return;
    const showBack = back.hidden;
    const turn = showBack ? 90 : -90;
    const animate = !reducedMotion.matches;
    const restingTransform = getComputedStyle(badge).transform;
    const tilted = (angle: number) => `perspective(700px) rotateY(${angle}deg) ${restingTransform}`;
    flipping = true;
    try {
      if (animate) {
        flipAnimation = badge.animate(
          [{ transform: tilted(0) }, { transform: tilted(turn) }],
          { duration: 150, easing: 'ease-in', fill: 'forwards' },
        );
        if (!threadFrame) threadFrame = requestAnimationFrame(followPins);
        await flipAnimation.finished;
      }
      front.hidden = showBack;
      back.hidden = !showBack;
      flip.setAttribute('aria-expanded', String(showBack));
      flip.textContent = showBack ? 'Show front ↻' : 'Flip ID ↻';
      if (animate) {
        const outgoing = flipAnimation;
        flipAnimation = badge.animate(
          [{ transform: tilted(-turn) }, { transform: tilted(0) }],
          { duration: 200, easing: 'ease-out', fill: 'forwards' },
        );
        outgoing?.cancel();
        await flipAnimation.finished;
      }
    } catch (error) {
      if (!(error instanceof DOMException && error.name === 'AbortError')) throw error;
    } finally {
      flipAnimation?.cancel();
      flipAnimation = undefined;
      flipping = false;
    }
  });
  const tilting = new Set<EventTarget>();
  let threadFrame = 0;
  function followPins() {
    draw();
    threadFrame = tilting.size || flipAnimation ? requestAnimationFrame(followPins) : 0;
  }
  grid.addEventListener('transitionrun', event => {
    if (event.propertyName !== 'translate' || !(event.target instanceof HTMLElement) || !event.target.matches('.sheet')) return;
    tilting.add(event.target);
    if (!threadFrame) threadFrame = requestAnimationFrame(followPins);
  });
  const stopFollowing = (event: TransitionEvent) => {
    if (event.propertyName === 'translate' && event.target) tilting.delete(event.target);
  };
  grid.addEventListener('transitionend', stopFollowing);
  grid.addEventListener('transitioncancel', stopFollowing);
  const dialog=root.querySelector<HTMLDialogElement>('.image-dialog')!;
  root.querySelectorAll('.enlarge').forEach(button=>button.addEventListener('click',()=>{
    const thumbnail=button.querySelector('img')!,image=dialog.querySelector('img')!;
    image.src=thumbnail.src;image.alt=thumbnail.alt;
    dialog.querySelector('p')!.textContent=button.closest('figure')!.querySelector('figcaption')!.textContent;
    dialog.showModal();
  }));
  dialog.querySelector('.close')!.addEventListener('click',()=>dialog.close());

  const afterHours = root.querySelector<HTMLDialogElement>('.after-hours-dialog')!;
  root.querySelector('.after-hours')!.addEventListener('click', () => afterHours.showModal());
  afterHours.querySelector('.close')!.addEventListener('click', () => afterHours.close());
  teardown = () => {
    observer.disconnect();
    cancelAnimationFrame(threadFrame);
    flipAnimation?.cancel();
    teardown = undefined;
  };
}

document.addEventListener('astro:page-load', initAboutBoard);
document.addEventListener('astro:before-swap', () => teardown?.());
</script>
