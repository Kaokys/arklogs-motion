---
import SignalMatrix from './SignalMatrix.astro';
---

<div class="cutout">
  <span class="drafting-ring" aria-hidden="true"></span>
  <div class="paper" aria-hidden="true">
    <span class="registration mark-top"></span>
    <span class="registration mark-bottom"></span>
    <div class="letters">
      <span class="ark">ARK</span>
      <span class="logs">LOGS</span>
    </div>
    <span class="ink-stamp"></span>
    <span class="barcode"></span>
    <div class="matrix"><SignalMatrix /></div>
  </div>
  <button class="seal" type="button" aria-label="Stamp the Arklogs wordmark">
    <span aria-hidden="true">✦</span>
  </button>
  <span class="stamp-status" role="status"></span>
</div>

<script>
  const stamps = [
    { symbol: '✦', name: 'Star' },
    { symbol: '⊕', name: 'Compass' },
    { symbol: '▣', name: 'Circuit' },
  ];

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const cutout = event.target.closest('.cutout .seal')?.closest<HTMLElement>('.cutout');
    if (!cutout) return;

    const ink = cutout.querySelector<HTMLElement>('.ink-stamp')!;
    const status = cutout.querySelector<HTMLElement>('.stamp-status')!;
    const index = (Number(cutout.dataset.stamp ?? -1) + 1) % stamps.length;
    const stamp = stamps[index];
    cutout.dataset.stamp = String(index);
    cutout.toggleAttribute('data-colors-flipped');
    ink.textContent = stamp.symbol;
    status.textContent = `${stamp.name} stamp applied`;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const letters = cutout.querySelectorAll<HTMLElement>('.letters span');
    for (const [position, letter] of letters.entries()) {
      const direction = position === 0 ? -1 : 1;
      letter.getAnimations().forEach((animation) => animation.cancel());
      letter.animate([
        { translate: '0 0', rotate: '0deg' },
        { translate: `${direction * 12}px ${direction * -8}px`, rotate: `${direction * 8}deg` },
        { translate: '0 0', rotate: '0deg' },
      ], { duration: 320, easing: 'ease-in-out' });
    }

    ink.getAnimations().forEach((animation) => animation.cancel());
    ink.animate([
      { opacity: 0, scale: 1.6 },
      { opacity: .8, scale: .94, offset: .75 },
      { opacity: .8, scale: 1 },
    ], { duration: 420, delay: 140, fill: 'backwards', easing: 'ease-out' });
  });
</script>
