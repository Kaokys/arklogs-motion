---
import SignalMatrix from './SignalMatrix.astro';
---

<div class="cutout">
  <span class="drafting-ring" aria-hidden="true"></span>
  <div class="paper" aria-hidden="true">
    <span class="registration mark-top"></span>
    <span class="registration mark-bottom"></span>
    <div class="letters">
      <span class="ark">ARK</span>
      <span class="logs">LOGS</span>
    </div>
    <span class="ink-stamp"></span>
    <span class="barcode"></span>
    <div class="matrix"><SignalMatrix /></div>
  </div>
  <button class="seal" type="button" aria-label="Stamp the Arklogs wordmark">
    <span aria-hidden="true">✦</span>
  </button>
  <span class="stamp-status" role="status"></span>
</div>

<script>
  const stamps = [
    { symbol: '✦', name: 'Star' },
    { symbol: '⊕', name: 'Compass' },
    { symbol: '▣', name: 'Circuit' },
  ];

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const cutout = event.target.closest('.cutout .seal')?.closest<HTMLElement>('.cutout');
    if (!cutout) return;

    const ink = cutout.querySelector<HTMLElement>('.ink-stamp')!;
    const status = cutout.querySelector<HTMLElement>('.stamp-status')!;
    const index = (Number(cutout.dataset.stamp ?? -1) + 1) % stamps.length;
    const stamp = stamps[index];
    cutout.dataset.stamp = String(index);
    cutout.toggleAttribute('data-colors-flipped');
    ink.textContent = stamp.symbol;
    status.textContent = `${stamp.name} stamp applied`;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const letters = cutout.querySelectorAll<HTMLElement>('.letters span');
    for (const [position, letter] of letters.entries()) {
      const direction = position === 0 ? -1 : 1;
      letter.getAnimations().forEach((animation) => animation.cancel());
      letter.animate([
        { translate: '0 0', rotate: '0deg' },
        { translate: `${direction * 12}px ${direction * -8}px`, rotate: `${direction * 8}deg` },
        { translate: '0 0', rotate: '0deg' },
      ], { duration: 320, easing: 'ease-in-out' });
    }

    ink.getAnimations().forEach((animation) => animation.cancel());
    ink.animate([
      { opacity: 0, scale: 1.6 },
      { opacity: .8, scale: .94, offset: .75 },
      { opacity: .8, scale: 1 },
    ], { duration: 420, delay: 140, fill: 'backwards', easing: 'ease-out' });
  });
</script>

<style>
  :global(.home-screen) {
    position: relative;
  }

  .cutout {
    --cobalt: #234bc4;
    --blue-paper: repeating-linear-gradient(0deg, #ffffff0b 0 1px, transparent 1px 4px), var(--cobalt);
    --white-paper: repeating-linear-gradient(0deg, #d7e6ec 0 1px, #fbfdfc 1px 4px);
    position: absolute;
    z-index: 2;
    top: 65%;
    left: 50%;
    width: clamp(230px, 32vw, 490px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    color: var(--cobalt);
  }

  .drafting-ring {
    position: absolute;
    inset: -19% -5%;
    border: 1px solid #4b75c8a3;
    border-radius: 50%;
    transform: rotate(-12deg);
  }

  .drafting-ring::after {
    content: '';
    position: absolute;
    inset: 12% 5%;
    border: 1px dashed #4b75c884;
    border-radius: inherit;
  }

  .paper {
    position: relative;
    padding: 12% 7%;
    transform: rotate(-4deg);
    background: radial-gradient(circle, #5c7eb04a 0.65px, transparent 0.9px) 0 0 / 5px 5px,
      linear-gradient(120deg, #f8fcfbeb, #d9eaf0db);
    clip-path: polygon(0 8%, 95% 0, 100% 91%, 3% 100%);
  }

  .letters {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: .04em;
    font-size: clamp(2.35rem, 5.45vw, 5.2rem);
    font-weight: 700;
    line-height: .93;
    letter-spacing: -.065em;
  }

  .letters span {
    display: block;
    padding: .1em .16em .14em;
    box-shadow: 3px 4px #476a9660, 5px 8px 0 #7c9db454;
  }

  .ark {
    color: #fff;
    background: var(--blue-paper);
    transform: rotate(-6deg);
    font-family: var(--heading-font);
  }

  .logs {
    color: #152e47;
    background: var(--white-paper);
    transform: rotate(7deg) translateY(6%);
    font-family: Georgia, serif;
  }

  .cutout[data-colors-flipped] .ark {
    color: #152e47;
    background: var(--white-paper);
  }

  .cutout[data-colors-flipped] .logs {
    color: #fff;
    background: var(--blue-paper);
  }

  .seal {
    position: absolute;
    top: 8%;
    right: 8%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    pointer-events: auto;
    cursor: pointer;
    transform: rotate(8deg);
  }

  .seal span {
    display: grid;
    place-items: center;
    width: clamp(26px, 3.1vw, 44px);
    aspect-ratio: 1;
    border: 1px solid #aac0e2;
    border-radius: 50%;
    background: var(--cobalt);
    color: #fff;
    font: 700 clamp(15px, 2.2vw, 29px)/1 Georgia, serif;
    box-shadow: 2px 2px #91aac5;
  }

  .seal:is(:hover, :focus-visible) span { background: #173795; }
  .seal:active span { box-shadow: inset 1px 2px #102770; }

  .ink-stamp {
    position: absolute;
    left: 10%;
    top: 8%;
    display: grid;
    place-items: center;
    width: clamp(20px, 3.8vw, 49px);
    aspect-ratio: 1;
    border: 3px double currentColor;
    border-radius: 50%;
    background: #f4faf4de;
    opacity: .8;
    color: var(--cobalt);
    font: 700 clamp(13px, 2.4vw, 31px)/1 Georgia, serif;
    transform: rotate(-19deg);
  }

  .ink-stamp:empty { display: none; }

  .stamp-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .barcode {
    position: absolute;
    left: 10%;
    bottom: 10%;
    width: 15%;
    height: 7%;
    background: repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 4px, currentColor 4px 6px, transparent 6px 8px);
  }

  .matrix {
    position: absolute;
    right: 9%;
    bottom: 10%;
    width: 9%;
    max-width: 36px;
  }

  .matrix :global(.signal-matrix) {
    width: 100%;
    gap: 1px;
  }

  .registration {
    position: absolute;
    width: 11%;
    height: 17%;
    border: solid #6485bc;
    border-width: 1px 0 0 1px;
  }

  .mark-top { left: 6%; top: 12%; }
  .mark-bottom { right: 5%; bottom: 7%; rotate: 180deg; }

  @media (min-width: 761px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cutout {
      translate: var(--float-x, 0px) var(--float-y, 0px);
      transition: translate 220ms ease-out;
    }
  }

  @media (max-width: 760px) {
    .cutout {
      z-index: 3;
      top: 80px;
      left: auto;
      right: 8%;
      width: clamp(125px, 36vw, 215px);
      transform: translateY(-50%);
    }

    .letters { font-size: clamp(1.25rem, 5.8vw, 2.2rem); }
    .seal { top: -9px; right: 3%; }
  }
</style>
