---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { areas } from '../../data/content';
export function getStaticPaths() { return areas.map((area) => ({ params: { id: area.id }, props: { area } })); }
const { area } = Astro.props;
---
<BaseLayout title={area.title}><div class="inner-screen"><aside class="side-panel"><div class="side-panel-top"><span>PROJECT AREA</span><span>{area.code}</span></div><div class="side-panel-body"><p class="overline">ARCHIVE RECORD</p><h1>{area.title}</h1><p>{area.description}</p></div><div class="side-panel-bottom"><a href="/projects/">← ALL PROJECTS</a></div></aside><section class="content-panel"><div class="content-panel-top"><span>RECORD OVERVIEW</span><span>IN PREPARATION</span></div><div class="content-panel-scroll"><div class="record-card"><div class="record-art"><img src={area.image} alt={area.imageDescription} /></div><div class="record-text"><p class="overline">CURRENT STATUS</p><h2>Entries are being prepared.</h2><p>{area.detail} This area is ready for the owner's project photos, drawings, and documentation.</p><a class="panel-link" href="/projects/">EXPLORE OTHER AREAS <span aria-hidden="true">↗</span></a></div></div></div></section></div></BaseLayout>
