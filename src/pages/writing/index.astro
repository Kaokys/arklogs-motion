---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignalMatrix from '../../components/SignalMatrix.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [latest, ...older] = posts;
---
<BaseLayout title="Writing" description="Field notes and writeups from the Arklogs workbench.">
  <div class="index-screen writing-screen">
    <div class="index-kicker"><span>ARKLOGS / FIELD NOTES</span><span>{String(posts.length).padStart(2, '0')} PUBLISHED</span></div>
    <div class="writing-board">
      <header class="writing-intro"><span class="board-label">LOGBOOK / 001</span><h1>Writing from<br /><em>the work.</em></h1><p>Build logs, security notes, CTF writeups, and the small details worth remembering.</p><span class="writing-rule" aria-hidden="true"></span><span class="writing-aside">A running record of questions, attempts, and what changed along the way.</span><SignalMatrix /></header>
      <section class="writing-records" aria-label="Published writing">
        <div class="records-heading"><span>PUBLISHED RECORDS</span><span>{String(posts.length).padStart(2, '0')} / OPEN</span></div>
        {latest ? <a class="featured-note" href={`/writing/${latest.id}/`}><span class="note-upper"><span>01 / {latest.data.category}</span><time datetime={latest.data.date.toISOString()}>{latest.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></span><span class="note-title">{latest.data.title}</span><span class="note-description">{latest.data.description}</span><span class="note-open">READ THE NOTE <span aria-hidden="true">↗</span></span></a> : <div class="notes-empty"><strong>No notes published yet.</strong><p>New work will be listed here when it is ready to share.</p></div>}
        {older.length > 0 && <div class="older-notes">{older.map((post, index) => <a href={`/writing/${post.id}/`}><span>{String(index + 2).padStart(2, '0')}</span><strong>{post.data.title}</strong><span aria-hidden="true">↗</span></a>)}</div>}
        <div class="records-end"><span>FROM THE WORKBENCH</span><a href="/projects/">EXPLORE PROJECT AREAS <span aria-hidden="true">↗</span></a></div>
      </section>
    </div>
    <div class="index-footer"><span>NOTES ARE PUBLISHED WHEN READY</span><a href="/about/">ABOUT ARKLOGS <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>
