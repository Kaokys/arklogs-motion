---
import BaseLayout from '../layouts/BaseLayout.astro';
import CutoutWordmark from '../components/CutoutWordmark.astro';
import SignalMatrix from '../components/SignalMatrix.astro';
import ScreenHeading from '../components/ScreenHeading.astro';
import ArchiveTimeline from '../components/ArchiveTimeline.astro';
import { sections } from '../data/content';
---
<BaseLayout title="Home" description="A portfolio template with space for a profile, achievements, projects, and writing.">
  <div class="home-screen">
    <div class="motion-stage" aria-hidden="true"><span class="motion-orbit orbit-one"></span><span class="motion-orbit orbit-two"></span><span class="motion-scan"></span><span class="motion-cross cross-one">＋</span><span class="motion-cross cross-two">＋</span></div>
    <CutoutWordmark />
    <ScreenHeading label="MAIN LINE PLOT" index="001" caption="SELECT A RECORD TO EXPLORE" />
    <a class="intro-panel" href="/about/" aria-label="About Me">
      <div class="intro-top"><span class="tiny-square"></span> CURATOR'S NOTE <span class="panel-id">A—001</span></div>
      <div class="intro-main"><p class="overline">A PERSONAL RECORD</p><h1>Ark<br /><em>logs.</em></h1></div>
      <div class="intro-bottom"><span>PORTFOLIO</span><SignalMatrix /><span class="intro-link-label">ABOUT ME <span aria-hidden="true">↗</span></span></div>
    </a>
    <section class="map-zone" aria-label="Explore archive areas">
      <div class="map-header"><span>ARCHIVE ROUTE <b>◈</b> PORTFOLIO SECTIONS</span><span class="map-readout">04 SECTIONS</span></div>
      <div class="map-grid" aria-hidden="true"></div>
      <div class="atlas-particles" aria-hidden="true">{Array.from({ length: 18 }, () => <span></span>)}</div>
      <div class="map-trace" aria-hidden="true"><svg viewBox="0 0 800 400" preserveAspectRatio="none"><path d="M28 258 L205 190 L392 227 L560 130 L750 176" /></svg></div>
      <div class="route-track" aria-label="Portfolio sections">
        {sections.map((section, index) => <a class="route-node" href={section.href} data-record data-code={section.code} data-category="Section" data-title={section.label} data-description={section.description} data-image={`/atlas-${section.code.toLowerCase()}.svg`}>
          <span class="node-index">{String(index + 1).padStart(2, '0')} <i></i> {section.code}</span>
          <span class="node-art"><img src={`/atlas-${section.code.toLowerCase()}.svg`} alt="" /><span class="node-chapter" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="art-shape art-shape-a" aria-hidden="true"></span><span class="art-center" aria-hidden="true">{section.code}</span></span>
          <span class="node-title">{section.label}</span>
        </a>)}
      </div>
      <div class="map-foot"><span>PORTFOLIO</span><a href="/blog/">ALL POSTS ↗</a></div>
    </section>
    <ArchiveTimeline />
  </div>
  <dialog class="record-dialog" aria-labelledby="record-dialog-title" aria-describedby="record-dialog-description">
    <div class="record-dialog-shell">
      <div class="record-dialog-art"><img src="" alt="" /><span class="record-dialog-code" aria-hidden="true"></span></div>
      <div class="record-dialog-body">
        <div class="record-dialog-top"><span class="record-dialog-category"></span><button class="record-dialog-close" type="button" aria-label="Close record">×</button></div>
        <div class="record-dialog-copy"><span class="record-dialog-kicker">ARKLOGS / SELECTED RECORD</span><h2 id="record-dialog-title"></h2><p id="record-dialog-description"></p><p class="record-dialog-detail"></p></div>
        <div class="record-dialog-actions"><a class="record-dialog-read" href="#">READ RECORD <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </dialog>
  <script>
    let cleanupDialog: (() => void) | undefined;
    const initDialog = () => {
      cleanupDialog?.();
      const dialog = document.querySelector<HTMLDialogElement>('.record-dialog');
      if (!dialog) return;
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.home-screen [data-record]'));
      const closeButtons = dialog.querySelectorAll<HTMLButtonElement>('.record-dialog-close');
      const art = dialog.querySelector<HTMLImageElement>('.record-dialog-art img')!;
      const code = dialog.querySelector<HTMLElement>('.record-dialog-code')!;
      const category = dialog.querySelector<HTMLElement>('.record-dialog-category')!;
      const title = dialog.querySelector<HTMLElement>('#record-dialog-title')!;
      const description = dialog.querySelector<HTMLElement>('#record-dialog-description')!;
      const detail = dialog.querySelector<HTMLElement>('.record-dialog-detail')!;
      const read = dialog.querySelector<HTMLAnchorElement>('.record-dialog-read')!;
      const body = dialog.querySelector<HTMLElement>('.record-dialog-body')!;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let trigger: HTMLAnchorElement | undefined;
      let closing = false;
      const cancelAnimations = () => dialog.getAnimations({ subtree: true }).forEach(animation => animation.cancel());
      const cardTransform = (card: DOMRect, panel: DOMRect) =>
        `translate(${card.left - panel.left}px, ${card.top - panel.top}px) scale(${card.width / panel.width}, ${card.height / panel.height})`;
      const open = (event: MouseEvent, card: HTMLAnchorElement) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (dialog.open) return;
        trigger = card;
        art.src = card.dataset.image || '';
        art.alt = '';
        code.textContent = card.dataset.code || '';
        category.textContent = card.dataset.category || '';
        title.textContent = card.dataset.title || '';
        description.textContent = card.dataset.description || '';
        detail.textContent = card.dataset.detail || '';
        read.href = card.href;
        const source = card.getBoundingClientRect();
        dialog.showModal();
        if (!reducedMotion.matches) {
          const target = dialog.getBoundingClientRect();
          dialog.animate(
            [{ transform: cardTransform(source, target), borderRadius: '3px' }, { transform: 'none', borderRadius: '0' }],
            { duration: 760, easing: 'cubic-bezier(.25, .8, .3, 1.1)' },
          );
          art.animate([{ scale: '1.12' }, { scale: '1' }], { duration: 1000, easing: 'ease-out' });
          body.animate(
            [{ opacity: 0, translate: '0 15px' }, { opacity: 1, translate: '0 0' }],
            { duration: 440, delay: 200, easing: 'ease-out', fill: 'backwards' },
          );
        }
        dialog.querySelector<HTMLButtonElement>('.record-dialog-close')?.focus();
      };
      const close = () => {
        if (!dialog.open || closing) return;
        const finish = () => {
          dialog.close();
          cancelAnimations();
          closing = false;
          trigger?.focus();
        };
        if (reducedMotion.matches || !trigger) {
          finish();
          return;
        }
        closing = true;
        const from = getComputedStyle(dialog).transform;
        const bodyOpacity = getComputedStyle(body).opacity;
        cancelAnimations();
        const target = dialog.getBoundingClientRect();
        const source = trigger.getBoundingClientRect();
        body.animate([{ opacity: bodyOpacity }, { opacity: 0 }], { duration: 200, fill: 'forwards' });
        dialog.animate(
          [{ transform: from }, { transform: cardTransform(source, target) }],
          { duration: 520, easing: 'ease-in-out', fill: 'forwards' },
        ).finished.then(finish, () => { closing = false; });
      };
      const cardListeners = cards.map((card) => { const listener = (event: MouseEvent) => open(event, card); card.addEventListener('click', listener); return { card, listener }; });
      closeButtons.forEach((button) => button.addEventListener('click', close));
      const onBackdrop = (event: MouseEvent) => { if (event.target === dialog) close(); };
      const onCancel = (event: Event) => { event.preventDefault(); close(); };
      dialog.addEventListener('click', onBackdrop);
      dialog.addEventListener('cancel', onCancel);
      cleanupDialog = () => {
        cardListeners.forEach(({ card, listener }) => card.removeEventListener('click', listener));
        closeButtons.forEach(button => button.removeEventListener('click', close));
        dialog.removeEventListener('click', onBackdrop);
        dialog.removeEventListener('cancel', onCancel);
        cancelAnimations();
        if (dialog.open) dialog.close();
      };
    };
    document.addEventListener('astro:page-load', initDialog);
    document.addEventListener('astro:before-swap', () => cleanupDialog?.());
    if (document.readyState !== 'loading') initDialog();
  </script>
</BaseLayout>
