---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalMatrix from '../components/SignalMatrix.astro';
import { areas } from '../data/content';
import { getCollection } from 'astro:content';
const latest = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---
<BaseLayout title="Home" description="Arklogs is a personal archive of projects, security research, CTF writeups, and field notes.">
  <div class="home-screen">
    <div class="motion-stage" aria-hidden="true"><span class="motion-orbit orbit-one"></span><span class="motion-orbit orbit-two"></span><span class="motion-scan"></span><span class="motion-cross cross-one">＋</span><span class="motion-cross cross-two">＋</span></div>
    <div class="motion-label" aria-hidden="true"><span>ARK</span><span>LOGS</span></div>
    <div class="screen-heading"><span>MAIN LINE PLOT <i></i> ARK / 001</span><span>SELECT A RECORD TO EXPLORE</span></div>
    <aside class="intro-panel">
      <div class="intro-top"><span class="tiny-square"></span> CURATOR'S NOTE <span class="panel-id">A—001</span></div>
      <div class="intro-main"><p class="overline">A PERSONAL RECORD</p><h1>Make.<br /><em>Investigate.</em><br />Document.</h1><p class="intro-description">Projects, investigations, and field notes from a curious workbench.</p></div>
      <div class="intro-bottom"><span>ESP32 <b>·</b> SECURITY <b>·</b> CTF</span><SignalMatrix /><a href="/about/">THE STORY BEHIND ARKLOGS <span aria-hidden="true">↗</span></a></div>
    </aside>
    <section class="map-zone" aria-label="Explore archive areas">
      <div class="map-header"><span>ARCHIVE ROUTE <b>◈</b> PROJECT AREAS</span><span class="map-readout">04 AREAS / LATEST NOTE</span></div>
      <div class="map-grid" aria-hidden="true"></div>
      <div class="atlas-particles" aria-hidden="true">{Array.from({ length: 18 }, () => <span></span>)}</div>
      <div class="map-trace" aria-hidden="true"><svg viewBox="0 0 800 400" preserveAspectRatio="none"><path d="M28 258 L205 190 L392 227 L560 130 L750 176" /></svg></div>
      <div class="route-track" aria-label="Archive areas and latest writing">
        {areas.map((area, index) => <a class="route-node" href={`/projects/${area.id}/`} data-record data-code={area.code} data-category={area.status} data-title={area.title} data-description={area.description} data-detail={area.detail} data-image={area.image}>
          <span class="node-index">{String(index + 1).padStart(2, '0')} <i></i> {area.code}</span>
          <span class="node-art"><img src={area.image} alt="" loading="eager" /><span class="node-chapter" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="art-shape art-shape-a" aria-hidden="true"></span><span class="art-center" aria-hidden="true">{area.code}</span></span>
          <span class="node-title">{area.title}</span><span class="node-sub">{area.status} <span aria-hidden="true">↗</span></span>
        </a>)}
        {latest && <a class="route-node recent-card" href={`/writing/${latest.id}/`} aria-label={`Read most recent post: ${latest.data.title}`} data-record data-code="NEW" data-category={latest.data.category} data-title={latest.data.title} data-description={latest.data.description} data-detail="The latest published note from the Arklogs workbench." data-image="/images/latest-note.svg">
          <span class="node-index">05 <i></i> MOST RECENT</span>
          <span class="node-art"><img src="/images/latest-note.svg" alt="" loading="eager" /><span class="node-chapter" aria-hidden="true">05</span><span class="art-center" aria-hidden="true">NEW</span></span>
          <span class="node-title">{latest.data.title}</span><span class="node-sub">{latest.data.category} / {latest.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} <span aria-hidden="true">↗</span></span>
        </a>}
      </div>
      <div class="map-foot"><span>PROJECTS</span><span>FOLLOW THE LINE OF THOUGHT</span><a href="/writing/">ALL WRITING ↗</a></div>
    </section>
    <div class="home-timeline" aria-label="Archive sections"><span>01 / 04</span><span class="timeline-rule"><i></i><i></i><i></i><i></i></span><span>04 / 04</span><a href="/writing/">FIELD NOTES <span aria-hidden="true">↗</span></a></div>
  </div>
  <dialog class="record-dialog" aria-labelledby="record-dialog-title" aria-describedby="record-dialog-description">
    <div class="record-dialog-shell">
      <div class="record-dialog-art"><img src="" alt="" /><span class="record-dialog-code" aria-hidden="true"></span></div>
      <div class="record-dialog-body">
        <div class="record-dialog-top"><span class="record-dialog-category"></span><button class="record-dialog-close" type="button" aria-label="Close record">×</button></div>
        <div class="record-dialog-copy"><span class="record-dialog-kicker">ARKLOGS / SELECTED RECORD</span><h2 id="record-dialog-title"></h2><p id="record-dialog-description"></p><p class="record-dialog-detail"></p></div>
        <div class="record-dialog-actions"><a class="record-dialog-read" href="#">READ RECORD <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </dialog>
  <script>
    import gsap from 'gsap';
    let cleanup: (() => void) | undefined;
    let cleanupDialog: (() => void) | undefined;
    const initDialog = () => {
      cleanupDialog?.();
      const dialog = document.querySelector<HTMLDialogElement>('.record-dialog');
      if (!dialog) return;
      const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.home-screen [data-record]'));
      const closeButtons = dialog.querySelectorAll<HTMLButtonElement>('.record-dialog-close');
      const art = dialog.querySelector<HTMLImageElement>('.record-dialog-art img')!;
      const code = dialog.querySelector<HTMLElement>('.record-dialog-code')!;
      const category = dialog.querySelector<HTMLElement>('.record-dialog-category')!;
      const title = dialog.querySelector<HTMLElement>('#record-dialog-title')!;
      const description = dialog.querySelector<HTMLElement>('#record-dialog-description')!;
      const detail = dialog.querySelector<HTMLElement>('.record-dialog-detail')!;
      const read = dialog.querySelector<HTMLAnchorElement>('.record-dialog-read')!;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      let trigger: HTMLAnchorElement | undefined;
      let busy = false;
      const open = (event: MouseEvent, card: HTMLAnchorElement) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (dialog.open) return;
        trigger = card;
        art.src = card.dataset.image || '';
        art.alt = '';
        code.textContent = card.dataset.code || '';
        category.textContent = card.dataset.category || '';
        title.textContent = card.dataset.title || '';
        description.textContent = card.dataset.description || '';
        detail.textContent = card.dataset.detail || '';
        read.href = card.href;
        dialog.showModal();
        if (!reduce.matches) {
          const source = card.getBoundingClientRect();
          const target = dialog.getBoundingClientRect();
          const body = dialog.querySelector('.record-dialog-body');
          const image = dialog.querySelector('.record-dialog-art img');
          gsap.fromTo(dialog, {
            x: source.left - target.left, y: source.top - target.top,
            scaleX: source.width / target.width, scaleY: source.height / target.height,
            transformOrigin: 'top left', borderRadius: 3
          }, {
            x: 0, y: 0, scaleX: 1, scaleY: 1, borderRadius: 0,
            duration: .76, ease: 'back.out(1.16)', clearProps: 'transform,borderRadius'
          });
          gsap.fromTo(image, { scale: 1.12 }, { scale: 1, duration: 1, ease: 'power2.out', clearProps: 'transform' });
          gsap.fromTo(body, { autoAlpha: 0, y: 15 }, { autoAlpha: 1, y: 0, duration: .44, delay: .2, ease: 'power2.out', clearProps: 'all' });
        }
        dialog.querySelector<HTMLButtonElement>('.record-dialog-close')?.focus();
      };
      const close = () => {
        if (!dialog.open || busy) return;
        if (reduce.matches) { dialog.close(); trigger?.focus(); return; }
        busy = true;
        const source = trigger?.getBoundingClientRect();
        const target = dialog.getBoundingClientRect();
        const body = dialog.querySelector('.record-dialog-body');
        const base = { width: dialog.offsetWidth, height: dialog.offsetHeight };
        gsap.to(body, { autoAlpha: 0, y: 8, duration: .2, overwrite: true });
        gsap.to(dialog, {
          x: (source?.left ?? target.left) - (target.left - gsap.getProperty(dialog, 'x') as number),
          y: (source?.top ?? target.top) - (target.top - gsap.getProperty(dialog, 'y') as number),
          scaleX: (source?.width ?? base.width) / base.width,
          scaleY: (source?.height ?? base.height) / base.height,
          transformOrigin: 'top left', duration: .52, ease: 'power2.inOut', overwrite: true,
          onComplete: () => { dialog.close(); gsap.set([dialog, body], { clearProps: 'all' }); busy = false; trigger?.focus(); }
        });
      };
      const cardListeners = cards.map((card) => { const listener = (event: MouseEvent) => open(event, card); card.addEventListener('click', listener); return { card, listener }; });
      closeButtons.forEach((button) => button.addEventListener('click', close));
      const onBackdrop = (event: MouseEvent) => { if (event.target === dialog) close(); };
      const onCancel = (event: Event) => { event.preventDefault(); close(); };
      dialog.addEventListener('click', onBackdrop);
      dialog.addEventListener('cancel', onCancel);
      cleanupDialog = () => { cardListeners.forEach(({ card, listener }) => card.removeEventListener('click', listener)); closeButtons.forEach((button) => button.removeEventListener('click', close)); dialog.removeEventListener('click', onBackdrop); dialog.removeEventListener('cancel', onCancel); gsap.killTweensOf(dialog); if (dialog.open) dialog.close(); };
    };
    const initMotion = () => {
      cleanup?.();
      const home = document.querySelector<HTMLElement>('.home-screen');
      if (!home) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const cards = Array.from(home.querySelectorAll<HTMLElement>('.route-node'));
      const intro = home.querySelector<HTMLElement>('.intro-panel');
      const label = home.querySelector<HTMLElement>('.motion-label');
      const stage = home.querySelector<HTMLElement>('.motion-stage');
      const timeline = gsap.timeline({ defaults: { ease: 'power3.out' } });
      timeline.fromTo(stage, { opacity: 0, scale: 1.06 }, { opacity: 1, scale: 1, duration: 1.2 }, 0)
        .fromTo(label, { opacity: 0, x: -42 }, { opacity: 1, x: 0, duration: .9 }, .12)
        .fromTo(intro, { opacity: 0, y: 32, rotateZ: -5 }, { opacity: 1, y: 0, rotateZ: 0, duration: .75 }, .22)
        .fromTo(cards, { opacity: 0, y: 64, scale: .92 }, { opacity: 1, y: 0, scale: 1, duration: .8, stagger: .095 }, .34);
      const canPoint = window.matchMedia('(min-width: 761px) and (pointer: fine)').matches;
      let onMove: ((event: PointerEvent) => void) | undefined;
      let onLeave: (() => void) | undefined;
      if (canPoint) {
        const xTo = cards.map((card) => gsap.quickTo(card, 'x', { duration: .8, ease: 'power2.out' }));
        const yTo = cards.map((card) => gsap.quickTo(card, 'y', { duration: .8, ease: 'power2.out' }));
        const labelX = gsap.quickTo(label, 'x', { duration: 1.1, ease: 'power2.out' });
        const labelY = gsap.quickTo(label, 'y', { duration: 1.1, ease: 'power2.out' });
        onMove = (event) => {
          const nx = event.clientX / window.innerWidth - .5;
          const ny = event.clientY / window.innerHeight - .5;
          cards.forEach((_, i) => { const depth = i === 4 ? 26 : 10 + i * 3; xTo[i](nx * depth); yTo[i](ny * depth); });
          labelX(nx * -12); labelY(ny * -9);
        };
        onLeave = () => { cards.forEach((_, i) => { xTo[i](0); yTo[i](0); }); labelX(0); labelY(0); };
        window.addEventListener('pointermove', onMove, { passive: true });
        window.addEventListener('blur', onLeave);
      }
      cleanup = () => { timeline.kill(); if (onMove) window.removeEventListener('pointermove', onMove); if (onLeave) window.removeEventListener('blur', onLeave); gsap.killTweensOf([...cards, intro, label, stage]); };
    };
    document.addEventListener('astro:page-load', () => { initMotion(); initDialog(); });
    document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanupDialog?.(); });
    if (document.readyState !== 'loading') { initMotion(); initDialog(); }
  </script>
</BaseLayout>
