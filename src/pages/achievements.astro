---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Achievements" description="Kao’s certificates and competition records.">
  <div class="index-screen writing-screen">
    <div class="index-kicker"><span>ARKLOGS / ACHIEVEMENTS</span><span>PERSONAL ARCHIVE</span></div>
    <div class="writing-board">
      <header class="writing-intro">
        <h1>Achievements</h1>
        <p>Certificates, competitions, and milestones.</p>
      </header>
      <section class="writing-records" aria-label="Achievement records">
        <a class="featured-note" href="/blog/thctt-2025-qualifier/">
          <span class="note-upper"><span>COMPETITION · JUNIOR QUALIFIER</span><span>2025</span></span>
          <span class="note-title">Thailand Cyber Top Talent</span>
          <span class="note-description">Junior qualifier participation record.</span>
          <span class="note-open">VIEW QUALIFIER NOTES</span>
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
