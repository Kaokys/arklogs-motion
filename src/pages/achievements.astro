---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Certificate {
  title: string;
  issuer: string;
  issued: string;
  image?: string;
}
const certificates: Certificate[] = [];
const examples = [
  { title: 'Blue Team Foundations', issuer: 'Security Academy', issued: '2026-04-01' },
  { title: 'Embedded Systems', issuer: 'Hardware Studio', issued: '2026-06-01' },
  { title: 'CTF Fundamentals', issuer: 'Cyber Lab', issued: '2026-08-01' },
  { title: 'Technical Writing', issuer: 'Writing Workshop', issued: '2026-10-01' }
];
const sample = certificates.length === 0;
const records: Certificate[] = [...(sample ? examples : certificates)].sort((a,b) => a.issued.localeCompare(b.issued));
const month = new Intl.DateTimeFormat('en', {month:'long', timeZone:'UTC'});
---
<BaseLayout title="Achievements" description="Kao’s certificate timeline, ordered by issue date.">
  <footer slot="footer" class="archive-foot"><b>Milestone timeline</b><span>{sample ? 'Sample certificates' : 'Certificates'}</span></footer>
  <section class="milestones">
    <header><div><small>Certificates by issue date</small><h1>Achievements</h1></div>
      <div class="scroll-controls">
        <button type="button" data-step="-1" aria-label="Scroll certificates left" aria-controls="certificate-strip">←</button>
        <button type="button" data-step="1" aria-label="Scroll certificates right" aria-controls="certificate-strip">→</button>
      </div>
    </header>
    <div id="certificate-strip" class="strip" tabindex="0" role="region" aria-label="Scrollable certificate timeline">
    <ol class="timeline" aria-label="Certificates by issue date">
      {records.map(record => <li>
        <button type="button" data-certificate aria-label={`View ${record.title} certificate`}>
          <span class="sheet">{record.image ? <img src={record.image} alt={record.title} /> :
            <span class="document"><small>{record.issuer}</small><b>Certificate</b><i>of completion presented to</i><em>Kao</em><span>{record.title}</span><small>{month.format(new Date(record.issued))}{sample && ' · Sample'}</small></span>}
          </span>
          <strong>{record.title}</strong><span class="issuer"><time datetime={record.issued}>{month.format(new Date(record.issued))}</time> · {record.issuer}</span>
        </button>
      </li>)}
    </ol>
    </div>
    <dialog aria-label="Certificate preview"><form method="dialog"><button type="submit">Close ×</button></form><div data-preview></div></dialog>
  </section>
</BaseLayout>
<script>
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const arrow = event.target.closest<HTMLButtonElement>('.scroll-controls [data-step]');
    if (arrow) {
      const strip = document.getElementById('certificate-strip');
      const cards = strip?.querySelectorAll('li');
      if (strip && cards && cards.length > 1) {
        strip.scrollBy({left:Number(arrow.dataset.step) * (cards[1].offsetLeft - cards[0].offsetLeft)});
      }
      return;
    }
    const button = event.target.closest('[data-certificate]');
    const dialog = button?.closest('.milestones')?.querySelector('dialog');
    const sheet = button?.querySelector('.sheet');
    if (!dialog || !sheet) return;

    const enlarged = sheet.cloneNode(true) as HTMLElement;
    const paperStyle = getComputedStyle(sheet);
    enlarged.style.color = paperStyle.color;
    enlarged.style.background = paperStyle.background;
    dialog.querySelector('[data-preview]')?.replaceChildren(enlarged);
    dialog.showModal();
  });
</script>
<style>
  :global(.app-main:has(.milestones)){display:block;padding:0;margin:0;overflow:auto;background:#edf3f3}
  .archive-foot{display:flex;align-items:center;justify-content:space-between;background:#f8fbfa;padding:0 5%;color:#17344b;font:13px 'Courier New',monospace}
  .archive-foot{border-top:1px solid #acc2cc}
  .milestones{min-height:100%;display:flex;flex-direction:column;background:#edf3f3;color:#19374e;padding:26px 0 20px}
  .milestones header{margin:0 6%}.milestones header small,.issuer{font:13px 'Courier New',monospace}
  .milestones h1{font:italic 700 25px Georgia,serif;letter-spacing:normal;text-transform:none;margin:3px 0 0}
  .milestones header{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .scroll-controls{display:flex;gap:5px}
  .scroll-controls button{width:44px;height:44px;background:#f8fbfa;color:#2448a0;border:1px solid #95adc2;font-size:20px;cursor:pointer}
  .strip{overflow-x:auto;overscroll-behavior-x:contain;scrollbar-color:#819bc8 #e0ebed;margin:auto 0;max-width:100%}
  .timeline{width:max-content;min-width:100%;display:grid;grid-auto-flow:column;grid-auto-columns:max(230px,25vw);align-items:center;gap:3vw;list-style:none;margin:0;padding:54px 6vw;position:relative;background:linear-gradient(90deg,#4567bf,#96afc9) center/94% 2px no-repeat}
  li{min-width:0;position:relative;align-self:center;padding:7px 6px 9px 8px;border-left:2px solid #365ac1;background:#edf3f3;transform:translateY(-30px)}
  li:nth-child(even){transform:translateY(30px)}
  @media(min-width:671px){
    .milestones{padding-top:19px}
    .issuer{font-size:12px}
  }
  [data-certificate]{position:relative;display:block;width:100%;padding:0;background:none;border:0;text-align:left;color:#19374e;cursor:pointer}
  [data-certificate]:focus-visible{outline:2px solid #254bc8;outline-offset:3px}
  .sheet{display:block;container-type:inline-size;color:#193e8a;background:#fffcf4}
  li:nth-child(4n+2) .sheet{color:#216566;background:linear-gradient(135deg,#cce1d7 7%,#fffdf2 7% 93%,#cce1d7 93%)}
  li:nth-child(4n+3) .sheet{color:#972f39;background:#faf0e6}li:nth-child(4n) .sheet{color:#513884;background:#f2f0fa}
  .document{display:flex;aspect-ratio:1.42;align-items:center;justify-content:center;flex-direction:column;position:relative;border:3px double currentColor;outline:1px solid #c1ac86;outline-offset:-6px;text-align:center;font:4cqw Georgia,serif}
  .document small{font:3.4cqw monospace}.document small:first-child{text-transform:uppercase;letter-spacing:.08em}.document b{font:italic bold 10cqw Georgia}.document em{font:italic 8cqw Georgia}
  .document:after{content:'✥';position:absolute;bottom:8%;right:7%;border:1px solid;border-radius:50%;color:#9b732d;font:7cqw Georgia;padding:0 .16em}
  .sheet img{display:block;width:100%;aspect-ratio:1.42;object-fit:contain}
  strong,.issuer{display:block}strong{font:700 clamp(16px,1.8vw,23px)/1.18 Arial,sans-serif;margin:7px 2px 9px}.issuer{line-height:1.25;margin-left:2px}
  dialog{width:min(740px,92vw);border:1px solid #9aafbd;padding:16px;background:#f8fbfa}dialog::backdrop{background:#18354aaa}dialog form{text-align:right;margin-bottom:8px}dialog button{cursor:pointer;padding:5px 12px}
  @media(max-width:670px){.timeline{grid-auto-columns:min(72vw,320px);gap:6vw}}
</style>
