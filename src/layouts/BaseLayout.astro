---
import '@fontsource/oswald/latin-400.css';
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-600.css';
import '@fontsource/oswald/latin-700.css';
import '@fontsource/noto-sans-sc/latin-400.css';
import '@fontsource/noto-sans-sc/latin-700.css';
import '../styles/global.css';
import '../styles/screen.css';
import '../styles/typography.css';
import '../styles/chapter-layout.css';
import '../styles/index-pages.css';
import '../styles/depth-ui.css';
import '../styles/stage-menu.css';
import '../styles/brand-nav.css';
import '../styles/motion-home.css';
import '../styles/graphic-system.css';
import '../styles/blog.css';
import '../styles/atlas.css';
import '../styles/about-board.css';
import '../styles/cutout-wordmark.css';
import ScreenHeading from '../components/ScreenHeading.astro';
import ArchiveTimeline from '../components/ArchiveTimeline.astro';
import { ClientRouter } from 'astro:transitions';
import { nav } from '../data/content';

interface Props { title: string; description?: string; }
const { title, description = 'Arklogs — projects, research, and field notes.' } = Astro.props;
const pathname = Astro.url.pathname;
const isAbout = /^\/about\/?$/.test(pathname);
const isBlog = pathname === '/archive' || pathname === '/archive/' || /^\/blog(?:\/|$)/.test(pathname);
const section = pathname.split('/')[1];
const headings = {
  about: { label: 'PROFILE RECORD', index: '002', caption: 'GET TO KNOW KAO' },
  achievements: { label: 'CERTIFICATE TIMELINE', index: '003', caption: 'SELECT A CERTIFICATE TO VIEW' },
  projects: { label: 'PROJECT ARCHIVE', index: '004', caption: 'EXPLORE PROJECTS' },
  blog: { label: 'WRITING ARCHIVE', index: '005', caption: 'BROWSE POSTS' },
};
const heading = headings[isBlog ? 'blog' : section as keyof typeof headings];
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e6e9eb" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Arklogs RSS" href="/rss.xml" />
    <title>{title} | Arklogs</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app-shell">
      <slot name="header"><header class="topbar">
        <a class="wordmark" href="/" aria-label="Arklogs home"><span class="wordmark-ark">ARK</span><span class="wordmark-logs">LOGS</span></a>
        <span class="topbar-caption">PERSONAL ARCHIVE <span>/</span> SYSTEM ONLINE</span>
        <nav class="top-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} data-astro-prefetch="load" aria-current={pathname === item.href ? 'page' : item.href === '/blog/' && isBlog ? 'location' : undefined}>
              <span class="route-marker" aria-hidden="true"></span>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <span class="topbar-corner" aria-hidden="true">＋</span>
      </header></slot>
      <main id="main" class:list={['app-main', { 'app-main-home': pathname === '/', 'app-main-blog': isBlog, 'app-main-about': isAbout, 'app-main-framed': heading }]}>
        {heading ? (
          <>
            <ScreenHeading {...heading} />
            <div class="section-frame"><slot /></div>
          </>
        ) : <slot />}
        {(heading || pathname === '/') && <ArchiveTimeline activeHref={isBlog ? '/blog/' : heading ? `/${section}/` : '/'} />}
      </main>
      <slot name="footer"><footer class="statusbar"><span><b class="status-dot"></b> ARKLOGS / FIELD ARCHIVE</span><span class="statusbar-center">BUILD · INVESTIGATE · DOCUMENT</span><span>EST. 2026 <span class="status-slash">/</span> OPEN ACCESS</span></footer></slot>
    </div>
  </body>
</html>

<style is:global>
  .app-main.app-main-framed {
    display: grid;
    grid-template-rows: minmax(26px, auto) minmax(0, 1fr) 56px;
    padding: 12px 30px 0;
    overflow: hidden;
    background: var(--archive-surround);
  }
  .app-main-framed > .screen-heading {
    position: static;
    display: flex;
    height: auto;
    min-width: 0;
    gap: 8px 16px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .app-main-framed > .screen-heading span:last-child {
    display: inline;
    margin-left: auto;
  }
  .section-frame {
    min-width: 0;
    min-height: 0;
    border: var(--archive-frame-border);
    background: #edf3f3;
    overflow: auto;
  }
  .section-frame > #kao-screen-board { border: 0; }
  .section-frame > .writing-screen {
    min-height: 100%;
    height: auto;
    padding: 0;
    grid-template-rows: minmax(0, 1fr);
  }
  .section-frame > .writing-screen > .writing-board { border: 0; }
  @media (max-width: 760px) {
    .app-main.app-main-framed {
      grid-template-rows: minmax(26px, auto) minmax(0, 1fr) 36px;
      padding: 8px 9px 0;
    }
  }
</style>
